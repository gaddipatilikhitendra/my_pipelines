			},
			{
				"name": "Name",
				"type": "String"
			},
			{
				"name": "Website",
				"type": "String"
			},
			{
				"name": "Country",
				"type": "String"
			},
			{
				"name": "Description",
				"type": "String"
			},
			{
				"name": "Founded",
				"type": "String"
			},
			{
				"name": "Industry",
				"type": "String"
			},
			{
				"name": "NoOfEmployees",
				"type": "String"
			}
		]
	}
}