{
	"name": "BatchCSV",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ADLS_Linked_Service",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"filename": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
